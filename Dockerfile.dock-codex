FROM node:24-slim AS base

ARG CODEX_VERSION=latest
ARG CODEX_INIT_SCRIPT=.dock-codex-init.sh

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    openssh-client \
  && rm -rf /var/lib/apt/lists/*

RUN npm install --global "@openai/codex@${CODEX_VERSION}"

WORKDIR /workspace

ENTRYPOINT ["codex"]

FROM base AS with-init

COPY ${CODEX_INIT_SCRIPT} /tmp/dock-codex-init.sh

RUN CODEX_VERSION="${CODEX_VERSION}" bash /tmp/dock-codex-init.sh \
  && rm /tmp/dock-codex-init.sh

FROM base AS without-init
