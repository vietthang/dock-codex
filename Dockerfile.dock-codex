FROM debian:bookworm-slim AS base

ARG CODEX_VERSION=latest
ARG CODEX_INIT_SCRIPT=.dock-codex-init.sh

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    openssh-client \
    procps \
  && rm -rf /var/lib/apt/lists/*

RUN CODEX_HOME=/opt/codex \
  CODEX_INSTALL_DIR=/usr/local/bin \
  CODEX_RELEASE="${CODEX_VERSION}" \
  CODEX_NON_INTERACTIVE=1 \
  sh -c 'curl -fsSL https://chatgpt.com/codex/install.sh | sh'

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/codex"]

FROM base AS with-init

COPY ${CODEX_INIT_SCRIPT} /tmp/dock-codex-init.sh

RUN CODEX_VERSION="${CODEX_VERSION}" bash /tmp/dock-codex-init.sh \
  && rm /tmp/dock-codex-init.sh

FROM base AS without-init
